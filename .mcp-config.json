{
  "mcpServers": {
    "ring5-workspace": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/vnicolas/workspace/repos/RING-5-unified-engine-v2"
      ]
    },
    "context7": {
      "command": "python3",
      "args": ["-m", "mcp_server_context7"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      },
      "capabilities": {
        "tools": true,
        "resources": true
      },
      "description": "GitHub integration for issues, PRs, and code review. Read-only for repository operations. NEVER use for git push/commit operations."
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "capabilities": {
        "tools": true
      },
      "description": "Headless browser tool to aid in E2E Streamlit interactions, taking screenshots, and debugging Web UI logic natively."
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "capabilities": {
        "tools": true
      },
      "description": "Fetches modern Python, Streamlit, or Pandas documentation from the web. Ideal when context7 is missing recent frameworks."
    }
  },
  "security": {
    "allowedPaths": ["${workspaceFolder}"],
    "prohibitedOperations": [
      "git add",
      "git commit",
      "git push",
      "git pull",
      "git checkout",
      "git branch",
      "git merge",
      "git rebase",
      "git stash",
      "git reset",
      "git revert",
      "git tag",
      "git clone",
      "rm -rf /",
      "rm -rf ~",
      "sudo",
      "chmod 777",
      "chown",
      "pip install --break-system-packages",
      "pip3 install --break-system-packages",
      "apt-get install",
      "yum install",
      "dnf install"
    ],
    "note": "AI agents are restricted to workspace-scoped operations only. Git version control is STRICTLY human-only. System-level installations are PROHIBITED."
  }
}
