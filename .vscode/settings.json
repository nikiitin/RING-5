{
  "makefile.configureOnOpen": false,
  "r.lsp.promptToInstall": false,

  // Python configuration
  "python.defaultInterpreterPath": "${workspaceFolder}/python_venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Editor behavior
  "editor.suggestSelection": "first",
  "editor.formatOnSave": true,

  // Python extensions use the repository environment and configuration.
  "[python]": {"editor.defaultFormatter": "ms-python.black-formatter"},
  "black-formatter.importStrategy": "fromEnvironment",
  "flake8.importStrategy": "fromEnvironment",
  "mypy-type-checker.importStrategy": "fromEnvironment",

  // Testing
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,

  // File associations
  "files.associations": {
    "*.md": "markdown"
  },

  // Search exclusions
  "search.exclude": {
    "**/python_venv": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/node_modules": true,
    "**/.mypy_cache": true
  },

  // Files to watch
  "files.watcherExclude": {
    "**/python_venv/**": true,
    "**/.pytest_cache/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true
  },

  // Disable markdown validation in Problems tab
  // (markdownlint runs via Trunk CLI instead)
  "markdownlint.config": {
    "default": false
  },

  // Trunk extension configuration
  "trunk.enableFormatOnSave": false,
  "trunk.enableDebugLogs": false
}
